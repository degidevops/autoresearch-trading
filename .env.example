# Copy this file to .env and choose ONE LLM mode below.

# ------------------------------------------------------------------
# LLM configuration
# Choose ONE of:
#   1) LLM_PROVIDER=local
#   2) LLM_PROVIDER=openai | anthropic
#   3) Run as agent from Hermes/Telegram/DM; if executing from inside
#      Hermes, leave LLM_PROVIDER unset or set to local/openai as needed.
# ------------------------------------------------------------------
# Option A: Local GGUF
LLM_PROVIDER=local
LOCAL_MODEL_PATH=/content/model.gguf

# Option B: External API
# LLM_PROVIDER=openai   # or anthropic
# LLM_API_KEY=YOUR_API_KEY_HERE
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# ------------------------------------------------------------------
# Backtest/trading settings
# ------------------------------------------------------------------
COMMISSION_PER_SIDE=0.0004
SLIPPAGE_PER_TRADE=0.0002
DATA_PATH=data/XAUUSD_1m_20140114_20260626.parquet
LOGS_DIR=logs
