# .env.example – copy to .env and fill in your values
# ---------------------------------------------------
# LLM configuration (required for API mode)
LLM_API_KEY=YOUR_API_KEY_HERE
LLM_PROVIDER=openai   # or anthropic, groq, etc.

# Optional overrides (you can keep defaults)
COMMISSION_PER_SIDE=0.0004
SLIPPAGE_PER_TRADE=0.0002
DATA_PATH=data/XAUUSD_1m_20140114_20260626.parquet
LOGS_DIR=logs
